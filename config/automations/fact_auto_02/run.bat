@echo off
setlocal
rem FACT automation launcher: fact_auto_02
rem Generated by `python cli.py automation script fact_auto_02`; edit freely.
title FACT automation - fact_auto_02

rem run from the project folder, whatever folder the click came from
cd /d "C:\Users\sanga\Desktop\fact_automation"

set "PY=C:\Users\sanga\Desktop\fact_automation\myvenv\Scripts\python.exe"
if not exist "%PY%" set "PY=python"

rem the first argument is a values file; without one, look beside this script
set "VALUES=%~1"
if "%VALUES%"=="" set "VALUES=%~dp0values.json"
if not exist "%VALUES%" (
  echo [ERROR] no values file: "%VALUES%"
  echo         put one beside this script, or drag one onto it.
  if "%~1"=="" pause
  exit /b 2
)

echo FACT automation: fact_auto_02
echo   values: "%VALUES%"
echo   stop: Alt+T  pause: Alt+P  resume: Alt+R
echo.

rem start at the step the screen belongs to, not at step 1
"%PY%" "cli.py" automation run fact_auto_02 --values "%VALUES%" --from-screen

rem keep the window open when the script was double-clicked
set "CODE=%ERRORLEVEL%"
echo.
echo Exit code %CODE% ^(0 saved, 1 failed or unconfirmed, 2 blocked, 3 stopped^)
if "%~1"=="" pause
endlocal & exit /b %CODE%
