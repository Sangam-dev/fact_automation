{
  "app": {
    "title_contains": "Invoice Manager",
    "process_name": null,
    "require_foreground": true,
    "pin_window": true
  },
  "fields": [
    { "name": "invoice_number", "field": "Invoice Number", "type": "text" },
    { "name": "customer_name", "field": "Customer Name", "type": "text" },
    { "name": "amount", "field": "Amount", "type": "number" }
  ],
  "actions": {
    "save_button": "Save Record",
    "new_record_button": "Add New",
    "wait_after_save_seconds": 1.5
  },
  "workflow": {
    "steps": [
      { "action": "click", "button": "Add New" },
      { "action": "fill", "key": "invoice_number" },
      { "action": "fill", "key": "customer_name" },
      { "action": "fill", "key": "amount" }
    ],
    "retry_on_failure": false,
    "pause_after_click_seconds": 0.5
  },
  "gemini": {
    "model": "gemini-3.6-flash",
    "max_image_dimension": 1600,
    "timeout_seconds": 60,
    "max_retries": 3,
    "max_ai_calls": 50,
    "min_layout_confidence": 0.6,
    "min_mapping_confidence": 0.6
  },
  "confirmation": {
    "success_region": null,
    "error_region": null,
    "success_pattern": "",
    "error_patterns": ["(?i)required", "(?i)invalid", "(?i)error"],
    "verifier": "row",
    "footprint": ["invoice_number"]
  },
  "scrolling": {
    "enabled": true,
    "max_screens": 6,
    "settle_seconds": 0.4,
    "wheel_notches": 5
  },
  "safety": {
    "stop_hotkey": "alt+t",
    "pause_hotkey": "alt+p",
    "resume_hotkey": "alt+r",
    "block_external_input": true,
    "max_attempts": 3,
    "action_delay_seconds": 0.15,
    "stop_on_failure": true
  }
}
